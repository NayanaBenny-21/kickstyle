<form id="searchForm" class="d-flex me-3 position-relative" style="width: 300px;" onsubmit="return handleSearch(event)">
  
  <div class="input-group w-100">
    <span class="input-group-text">
      <i class="bi bi-search"></i>
    </span>

    <!-- Input -->
    <input 
      type="search" 
      id="searchInput" 
      name="q"
      class="form-control pe-5" 
      placeholder="Search"
      value="{{query}}"
      oninput="toggleClearBtn()"

    >
  </div>

  <!-- CLEAR BUTTON -->
  <button 
    type="button"
    id="clearBtn"
    class="btn position-absolute top-50 end-0 translate-middle-y me-2 p-0 border-0 bg-transparent d-none"
    style="font-size: 18px;"
  >
    ✖
  </button>

</form>

